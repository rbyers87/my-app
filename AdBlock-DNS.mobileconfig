            <integer>1</integer>
        </dict>
    </array>
    <key>PayloadDescription</key>
    <string>Blocks ads and trackers in Safari and in apps by using AdGuard's encrypted DNS (DNS over HTTPS).</string>
    <key>PayloadDisplayName</key>
    <string>Ad Blocker (System-wide)</string>
    <key>PayloadIdentifier</key>
    <string>com.user.adblock.dns</string>
